@using Microsoft.AspNetCore.Routing
@model AdminSolicitudIndexViewModel
@{
    ViewData["Title"] = "Panel de Administración — Solicitudes";
    var rutaFiltros = new RouteValueDictionary
    {
        ["busqueda"] = Model.Busqueda,
        ["estado"] = Model.EstadoFiltro,
        ["tipoAduanaId"] = Model.TipoAduanaFiltro,
        ["aduanaId"] = Model.AduanaFiltro,
        ["componenteId"] = Model.ComponenteFiltro,
        ["subcomponenteId"] = Model.SubcomponenteFiltro,
        ["elementoId"] = Model.ElementoFiltro,
        ["prioridadId"] = Model.PrioridadFiltro,
        ["unidadEjecutoraId"] = Model.UnidadEjecutoraFiltro,
        ["fechaDesde"] = Model.FechaDesde?.ToString("yyyy-MM-dd"),
        ["fechaHasta"] = Model.FechaHasta?.ToString("yyyy-MM-dd"),
    };
}

<div class="container-page">
    <partial name="_AdminTabs" model="@("solicitudes")" />


    <div class="card" style="padding:20px 22px;margin-bottom:16px;">
        <h3 style="margin:0 0 4px;font-size:16px;">Gestión de Solicitudes</h3>
        <p style="margin:0 0 16px;color:var(--dga-muted);font-size:13px;">Visualiza, filtra y administra todas las solicitudes registradas en el sistema.</p>
        <form method="get" class="filters-bar" style="margin:0 0 4px;">
            <div class="field" style="min-width:240px;flex:1;">
                <label>Buscar</label>
                <input type="text" name="busqueda" value="@Model.Busqueda" class="form-control" placeholder="ID de solicitud o nombre del solicitante" />
            </div>
            <div class="field">
                <label>Estado</label>
                <select name="estado" class="form-control" onchange="this.form.submit()">
                    <option value="">Todos</option>
                    @foreach (var opcion in Model.EstadoOptions)
                    {
                        <option value="@opcion.Id" selected="@(Model.EstadoFiltro == opcion.Id)">@opcion.Nombre</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Tipo de Aduana</label>
                <select name="tipoAduanaId" class="form-control" onchange="this.form.submit()">
                    <option value="">Todos</option>
                    @foreach (var opcion in Model.TipoAduanaOptions)
                    {
                        <option value="@opcion.Id" selected="@(Model.TipoAduanaFiltro == opcion.Id)">@opcion.Nombre</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Aduana</label>
                <select name="aduanaId" class="form-control" onchange="this.form.submit()">
                    <option value="">Todas</option>
                    @foreach (var opcion in Model.AduanaOptions)
                    {
                        <option value="@opcion.Id" selected="@(Model.AduanaFiltro == opcion.Id)">@opcion.Nombre</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Unidad Ejecutora</label>
                <select name="unidadEjecutoraId" class="form-control" onchange="this.form.submit()">
                    <option value="">Todas</option>
                    @foreach (var opcion in Model.UnidadEjecutoraOptions)
                    {
                        <option value="@opcion.Id" selected="@(Model.UnidadEjecutoraFiltro == opcion.Id)">@opcion.Nombre</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Componente</label>
                <select name="componenteId" class="form-control" onchange="this.form.submit()">
                    <option value="">Todos</option>
                    @foreach (var opcion in Model.ComponenteOptions)
                    {
                        <option value="@opcion.Id" selected="@(Model.ComponenteFiltro == opcion.Id)">@opcion.Nombre</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Subcomponente</label>
                <select name="subcomponenteId" class="form-control" onchange="this.form.submit()" disabled="@(!Model.ComponenteFiltro.HasValue)">
                    @if (!Model.ComponenteFiltro.HasValue)
                    {
                        <option value="">Elegí un componente primero</option>
                    }
                    else
                    {
                        <option value="">Todos</option>
                        @foreach (var opcion in Model.SubcomponenteOptions)
                        {
                            <option value="@opcion.Id" selected="@(Model.SubcomponenteFiltro == opcion.Id)">@opcion.Nombre</option>
                        }
                    }
                </select>
            </div>
            <div class="field">
                <label>Elemento</label>
                <select name="elementoId" class="form-control" onchange="this.form.submit()" disabled="@(!Model.SubcomponenteFiltro.HasValue)">
                    @if (!Model.SubcomponenteFiltro.HasValue)
                    {
                        <option value="">Elegí un subcomponente primero</option>
                    }
                    else
                    {
                        <option value="">Todos</option>
                        @foreach (var opcion in Model.ElementoOptions)
                        {
                            <option value="@opcion.Id" selected="@(Model.ElementoFiltro == opcion.Id)">@opcion.Nombre</option>
                        }
                    }
                </select>
            </div>
            <div class="field">
                <label>Prioridad</label>
                <select name="prioridadId" class="form-control" onchange="this.form.submit()">
                    <option value="">Todas</option>
                    @foreach (var opcion in Model.PrioridadOptions)
                    {
                        <option value="@opcion.Id" selected="@(Model.PrioridadFiltro == opcion.Id)">@opcion.Nombre</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Desde</label>
                <input type="date" name="fechaDesde" class="form-control" value="@Model.FechaDesde?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="field">
                <label>Hasta</label>
                <input type="date" name="fechaHasta" class="form-control" value="@Model.FechaHasta?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="field" style="min-width:0;display:flex;gap:8px;">
                <button type="submit" class="btn btn-outline">Filtrar</button>
                @if (Model.TieneFiltrosActivos)
                {
                    <a asp-action="Index" class="btn btn-link">Limpiar filtros</a>
                }
            </div>
        </form>
    </div>

    <div class="card">
        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th><th>Componente</th><th>Elemento</th><th>Detalle</th><th>Aduana</th><th>Fecha</th><th>Estado</th><th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Solicitudes.Count == 0)
                    {
                        <tr><td colspan="8" style="text-align:center;color:var(--dga-muted);padding:28px;">No hay solicitudes que coincidan con el filtro.</td></tr>
                    }
                    else
                    {
                        foreach (var s in Model.Solicitudes)
                        {
                            <tr>
                                <td style="font-weight:600;">@s.IdSolicitud</td>
                                <td>@s.Componente</td>
                                <td>@s.Elemento</td>
                                <td>@s.Detalle</td>
                                <td>@s.Aduana</td>
                                <td>@s.FechaRegistro.ASalvador().ToString("dd/MM/yyyy")</td>
                                <td><partial name="_EstadoBadge" model="@s.Estado" /></td>
                                <td>
                                    <div class="row-actions">
                                        <a asp-action="Details" asp-route-id="@s.Id" class="btn-action is-primary" title="Ver Detalles" aria-label="Ver Detalles"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /></svg><span class="btn-action__tip">Detalles</span></a>
                                        <a asp-action="DescargarPdf" asp-route-id="@s.Id" class="btn-action is-pdf" title="Descargar PDF" aria-label="Descargar PDF"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" /><path d="M14 2v6h6" /></svg><span class="btn-action__tip">PDF</span></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="pagination">
            <span>Mostrando página @Model.PaginaActual de @Model.TotalPaginas (@Model.TotalResultados resultados)</span>
            <div style="display:flex;gap:8px;">
                <a class="btn btn-outline btn-sm @(Model.PaginaActual <= 1 ? "disabled" : "")"
                   href="@Url.Action("Index", MergePagina(rutaFiltros, Model.PaginaActual - 1))">Anterior</a>
                <a class="btn btn-outline btn-sm @(Model.PaginaActual >= Model.TotalPaginas ? "disabled" : "")"
                   href="@Url.Action("Index", MergePagina(rutaFiltros, Model.PaginaActual + 1))">Siguiente</a>
            </div>
        </div>
    </div>
</div>

@functions {
    private static RouteValueDictionary MergePagina(RouteValueDictionary filtros, int pagina)
    {
        var copia = new RouteValueDictionary(filtros) { ["pagina"] = pagina };
        return copia;
    }
}
