@model MisRequerimientoIndexViewModel
@{
    ViewData["Title"] = "Mis Requerimientos";
}

<div class="container-page" style="padding-top:28px;">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:20px;">
        <div>
            <h1 class="section-title" style="margin:0 0 4px;">Mis Requerimientos</h1>
            <p style="margin:0;color:var(--dga-muted);font-size:13px;">Solicitudes que el Administrador te asignó para tramitar</p>
        </div>
    </div>

    <form method="get" class="card" style="padding:16px 18px;display:flex;gap:12px;flex-wrap:wrap;align-items:end;margin-bottom:20px;">
        <div style="flex:1;min-width:220px;">
            <label class="form-label">Buscar</label>
            <input type="text" name="busqueda" value="@Model.Busqueda" class="form-control" placeholder="Buscar ID o responsable..." />
        </div>
        <div style="min-width:200px;">
            <label class="form-label">Estado</label>
            <select name="estado" class="form-control">
                <option value="">Todos</option>
                @foreach (var opcion in Model.EstadoOptions)
                {
                    <option value="@opcion.Id" selected="@(Model.EstadoFiltro == opcion.Id)">@opcion.Nombre</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-outline">Filtrar</button>
    </form>

    <div class="card" style="overflow-x:auto;">
        @if (Model.Solicitudes.Count == 0)
        {
            <div style="padding:32px;text-align:center;color:var(--dga-muted);">No tenés requerimientos asignados por el momento.</div>
        }
        else
        {
            <table style="width:100%;border-collapse:collapse;min-width:720px;">
                <thead>
                    <tr style="text-align:left;font-size:12.5px;color:var(--dga-muted);border-bottom:1px solid var(--dga-border);">
                        <th style="padding:12px 16px;">ID</th>
                        <th style="padding:12px 16px;">Estado</th>
                        <th style="padding:12px 16px;">Responsable</th>
                        <th style="padding:12px 16px;">Aduana</th>
                        <th style="padding:12px 16px;">Asignado el</th>
                        <th style="padding:12px 16px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Solicitudes)
                    {
                        <tr style="border-bottom:1px solid var(--dga-border);">
                            <td style="padding:12px 16px;font-weight:600;">@s.IdSolicitud</td>
                            <td style="padding:12px 16px;"><partial name="_EstadoBadge" model="@s.Estado" /></td>
                            <td style="padding:12px 16px;">@s.NombreResponsable</td>
                            <td style="padding:12px 16px;">@s.Aduana</td>
                            <td style="padding:12px 16px;">@(s.FechaRevision.HasValue ? s.FechaRevision.Value.ASalvador().ToString("dd/MM/yyyy") : "-")</td>
                            <td style="padding:12px 16px;">
                                <div class="row-actions">
                                    <a asp-action="Details" asp-route-id="@s.Id" class="btn-action is-primary" title="Ver Detalle" aria-label="Ver Detalle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /></svg><span class="btn-action__tip">Ver Detalle</span></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
