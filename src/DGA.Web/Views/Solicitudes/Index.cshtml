@model SolicitudIndexViewModel
@{
    ViewData["Title"] = "Mis Solicitudes";
}

<div class="container-page" style="padding-top:28px;">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:20px;">
        <h1 class="section-title" style="margin:0;">Mis Solicitudes</h1>
        <a asp-controller="Solicitudes" asp-action="Create" class="btn btn-primary">Nueva Solicitud</a>
    </div>

    <form method="get" class="card" style="padding:16px 18px;display:flex;gap:12px;flex-wrap:wrap;align-items:end;margin-bottom:20px;">
        <div style="flex:1;min-width:220px;">
            <label class="form-label">Buscar</label>
            <input type="text" name="busqueda" value="@Model.Busqueda" class="form-control" placeholder="Buscar ID o responsable..." />
        </div>
        <div style="min-width:200px;">
            <label class="form-label">Estado</label>
            <select name="estado" class="form-control">
                <option value="">Todos</option>
                @foreach (var opcion in Model.EstadoOptions)
                {
                    <option value="@opcion.Id" selected="@(Model.EstadoFiltro == opcion.Id)">@opcion.Nombre</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-outline">Filtrar</button>
    </form>

    <div class="card" style="overflow-x:auto;">
        @if (Model.Solicitudes.Count == 0)
        {
            <div style="padding:32px;text-align:center;color:var(--dga-muted);">No hay solicitudes registradas todavía.</div>
        }
        else
        {
            <table style="width:100%;border-collapse:collapse;min-width:720px;">
                <thead>
                    <tr style="text-align:left;font-size:12.5px;color:var(--dga-muted);border-bottom:1px solid var(--dga-border);">
                        <th style="padding:12px 16px;">ID</th>
                        <th style="padding:12px 16px;">Estado</th>
                        <th style="padding:12px 16px;">Responsable</th>
                        <th style="padding:12px 16px;">Fecha Registro</th>
                        <th style="padding:12px 16px;">Fotografías</th>
                        <th style="padding:12px 16px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Solicitudes)
                    {
                        <tr style="border-bottom:1px solid var(--dga-border);">
                            <td style="padding:12px 16px;font-weight:600;">@s.IdSolicitud</td>
                            <td style="padding:12px 16px;"><span class="status-badge">@s.Estado</span></td>
                            <td style="padding:12px 16px;">@s.NombreResponsable</td>
                            <td style="padding:12px 16px;">@s.FechaRegistro.ToString("dd/MM/yyyy")</td>
                            <td style="padding:12px 16px;">@s.CantidadFotografias</td>
                            <td style="padding:12px 16px;">
                                <div style="display:flex;gap:8px;flex-wrap:wrap;">
                                    <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-outline btn-sm">Ver Detalle</a>
                                    <a asp-action="DescargarPdf" asp-route-id="@s.Id" class="btn btn-outline btn-sm" title="Descargar PDF">PDF</a>
                                    <a asp-action="DescargarExcel" asp-route-id="@s.Id" class="btn btn-outline btn-sm" title="Descargar Excel">Excel</a>
                                    @if (s.EsEditable)
                                    {
                                        <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-outline btn-sm">Editar</a>
                                    }
                                    @if (s.PuedeDescartar)
                                    {
                                        <form asp-action="Descartar" asp-route-id="@s.Id" method="post"
                                              data-confirm="¿Descartar esta solicitud en borrador? Esta acción no se puede deshacer." data-confirm-peligroso="true">
                                            <button type="submit" class="btn btn-outline btn-sm" style="color:var(--dga-danger);">Descartar</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
