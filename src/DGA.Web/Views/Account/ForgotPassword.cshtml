@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Recuperar Contraseña";
    Layout = "_AuthLayout";
}

<div class="auth-card__header">
    <h1 class="auth-card__title">Recuperar Contraseña</h1>
    <p class="auth-card__subtitle">Le enviaremos un enlace de recuperación</p>
</div>
<div class="auth-card__body">
    <form asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="form-group">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" placeholder="usuario@empresa.com" autocomplete="username" autofocus />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Enviar enlace de recuperación</button>
    </form>
</div>
<div class="auth-card__footer">
    <a asp-controller="Account" asp-action="Login">Volver al inicio de sesión</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
