@model SolicitudIndexViewModel
@{
    ViewData["Title"] = "Mis Solicitudes";
}

<div class="container-page" style="padding-top:28px;">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:20px;">
        <h1 class="section-title" style="margin:0;">Mis Solicitudes</h1>
        <a asp-controller="Solicitudes" asp-action="Create" class="btn btn-primary">Nueva Solicitud</a>
    </div>

    <form method="get" class="card" style="padding:16px 18px;display:flex;gap:12px;flex-wrap:wrap;align-items:end;margin-bottom:20px;">
        <div style="flex:1;min-width:220px;">
            <label class="form-label">Buscar</label>
            <input type="text" name="busqueda" value="@Model.Busqueda" class="form-control" placeholder="Buscar ID o responsable..." />
        </div>
        <div style="min-width:200px;">
            <label class="form-label">Estado</label>
            <select name="estado" class="form-control">
                <option value="">Todos</option>
                @foreach (var opcion in Model.EstadoOptions)
                {
                    <option value="@opcion.Id" selected="@(Model.EstadoFiltro == opcion.Id)">@opcion.Nombre</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-outline">Filtrar</button>
    </form>

    <div class="card" style="overflow-x:auto;">
        @if (Model.Solicitudes.Count == 0)
        {
            <div style="padding:32px;text-align:center;color:var(--dga-muted);">No hay solicitudes registradas todavía.</div>
        }
        else
        {
            <table style="width:100%;border-collapse:collapse;min-width:720px;">
                <thead>
                    <tr style="text-align:left;font-size:12.5px;color:var(--dga-muted);border-bottom:1px solid var(--dga-border);">
                        <th style="padding:12px 16px;">ID</th>
                        <th style="padding:12px 16px;">Estado</th>
                        <th style="padding:12px 16px;">Responsable</th>
                        <th style="padding:12px 16px;">Fecha Registro</th>
                        <th style="padding:12px 16px;">Fotografías</th>
                        <th style="padding:12px 16px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Solicitudes)
                    {
                        <tr style="border-bottom:1px solid var(--dga-border);">
                            <td style="padding:12px 16px;font-weight:600;">@s.IdSolicitud</td>
                            <td style="padding:12px 16px;"><partial name="_EstadoBadge" model="@s.Estado" /></td>
                            <td style="padding:12px 16px;">@s.NombreResponsable</td>
                            <td style="padding:12px 16px;">@s.FechaRegistro.ToString("dd/MM/yyyy")</td>
                            <td style="padding:12px 16px;">@s.CantidadFotografias</td>
                            <td style="padding:12px 16px;">
                                <div class="row-actions">
                                    <a asp-action="Details" asp-route-id="@s.Id" class="btn-action is-primary" title="Ver Detalle" aria-label="Ver Detalle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /></svg><span class="btn-action__tip">Ver Detalle</span></a>
                                    <a asp-action="DescargarPdf" asp-route-id="@s.Id" class="btn-action is-pdf" title="Descargar PDF" aria-label="Descargar PDF"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" /><path d="M14 2v6h6" /></svg><span class="btn-action__tip">PDF</span></a>
                                    <a asp-action="DescargarExcel" asp-route-id="@s.Id" class="btn-action is-excel" title="Descargar Excel" aria-label="Descargar Excel"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" /><path d="M3 9h18" /><path d="M3 15h18" /><path d="M9 3v18" /></svg><span class="btn-action__tip">Excel</span></a>
                                    @if (s.EsEditable)
                                    {
                                        <a asp-action="Edit" asp-route-id="@s.Id" class="btn-action" title="Editar" aria-label="Editar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" /><path d="m15 5 4 4" /></svg><span class="btn-action__tip">Editar</span></a>
                                    }
                                    @if (s.PuedeDescartar)
                                    {
                                        <form asp-action="Descartar" asp-route-id="@s.Id" method="post"
                                              data-confirm="¿Descartar esta solicitud en borrador? Esta acción no se puede deshacer." data-confirm-peligroso="true">
                                            <button type="submit" class="btn-action is-danger" title="Descartar" aria-label="Descartar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg><span class="btn-action__tip">Descartar</span></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
