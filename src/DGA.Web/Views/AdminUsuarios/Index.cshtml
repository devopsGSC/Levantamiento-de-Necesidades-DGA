@model AdminUsuarioIndexViewModel
@{
    ViewData["Title"] = "Panel de Administración — Usuarios";
}

<div class="container-page">
    <partial name="_AdminTabs" model="@("usuarios")" />

    <div class="card" style="padding:20px 22px;margin-bottom:16px;">
        <div style="display:flex;justify-content:space-between;align-items:start;flex-wrap:wrap;gap:12px;margin-bottom:16px;">
            <div>
                <h3 style="margin:0 0 4px;font-size:16px;">Directorio de Usuarios</h3>
                <p style="margin:0;color:var(--dga-muted);font-size:13px;">Gestión de accesos, roles y credenciales</p>
            </div>
            <div style="display:flex;gap:10px;">
                <a asp-action="CargaMasiva" class="btn btn-outline">Carga Masiva</a>
                <a asp-action="Crear" class="btn btn-primary">Crear Nuevo Usuario</a>
            </div>
        </div>
    </div>

    <form method="get" id="form-buscar-usuarios" class="filters-bar">
        <div class="field" style="max-width:320px;">
            <label>Buscar</label>
            <input type="text" name="busqueda" value="@Model.Busqueda" class="form-control" placeholder="Nombre o correo del usuario..." />
        </div>
    </form>

    <div id="usuarios-resultado">
        <partial name="_TablaUsuarios" model="Model" />
    </div>
</div>

<div class="modal-overlay" id="modal-cambiar-contrasena" hidden>
    <div class="modal-box">
        <form asp-action="CambiarContrasena" method="post">
            <input type="hidden" name="id" id="cc-id" />
            <div class="modal-box__header">
                <h3>Cambiar Contraseña</h3>
                <p>Vas a establecer una nueva contraseña para <strong id="cc-email">-</strong>.</p>
            </div>
            <div class="modal-box__body">
                <div class="form-group">
                    <label class="form-label">Nueva Contraseña</label>
                    <input type="password" name="nuevaContrasena" id="cc-nueva" class="form-control" minlength="6" required autocomplete="new-password" />
                </div>
                <div class="form-group">
                    <label class="form-label">Confirmar Contraseña</label>
                    <input type="password" name="confirmarContrasena" id="cc-confirmar" class="form-control" minlength="6" required autocomplete="new-password" />
                </div>
            </div>
            <div class="modal-box__footer">
                <button type="button" class="btn btn-outline" id="cc-cerrar">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar Contraseña</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var modal = document.getElementById('modal-cambiar-contrasena');
            var inputId = document.getElementById('cc-id');
            var email = document.getElementById('cc-email');
            var nueva = document.getElementById('cc-nueva');
            var confirmar = document.getElementById('cc-confirmar');

            document.getElementById('cc-cerrar').addEventListener('click', function () {
                modal.hidden = true;
            });

            modal.querySelector('form').addEventListener('submit', function (e) {
                if (nueva.value !== confirmar.value) {
                    e.preventDefault();
                    dgaToast('Las contraseñas no coinciden.', 'danger');
                }
            });

            // Vuelve a cablear los botones/forms de cada fila de la tabla — se llama
            // tanto al cargar la página como después de reemplazar el resultado por
            // AJAX (búsqueda en vivo), porque las filas nuevas son nodos del DOM
            // sin ningún listener todavía.
            function wireFilas(root) {
                root.querySelectorAll('[data-abrir-modal-contrasena]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        inputId.value = btn.dataset.id;
                        email.textContent = btn.dataset.email;
                        nueva.value = '';
                        confirmar.value = '';
                        modal.hidden = false;
                        nueva.focus();
                    });
                });

                // El mensaje de confirmación depende de qué rol se elige, así que no
                // se puede armar con un atributo data-confirm estático: se pide la
                // confirmación acá mismo y recién después se envía el form.
                root.querySelectorAll('.js-form-cambiar-rol').forEach(function (form) {
                    var select = form.querySelector('select');
                    var valorAnterior = select.value;
                    select.addEventListener('change', function () {
                        var nuevoTexto = select.selectedOptions[0].text;
                        dgaConfirm('¿Cambiar el rol de ' + form.dataset.email + ' a ' + nuevoTexto + '?').then(function (ok) {
                            if (ok) {
                                form.submit();
                            } else {
                                select.value = valorAnterior;
                            }
                        });
                    });
                });

                window.dgaWireConfirmForms(root);
            }
            wireFilas(document);

            // ---------------------------------------------------------------
            // Búsqueda en vivo — filtra a medida que se escribe, sin recargar la
            // página. El form sigue funcionando igual con JS desactivado (GET
            // normal), acá solo interceptamos submit/input para pedir el mismo
            // resultado por AJAX y reemplazar la tabla.
            // ---------------------------------------------------------------

            var form = document.getElementById('form-buscar-usuarios');
            var input = form.querySelector('input[name="busqueda"]');
            var resultado = document.getElementById('usuarios-resultado');
            var debounceTimer = null;
            var peticionActual = null;

            async function buscar(termino) {
                if (peticionActual) peticionActual.abort();
                var controlador = new AbortController();
                peticionActual = controlador;

                var url = new URL(location.pathname, location.origin);
                if (termino) url.searchParams.set('busqueda', termino);

                try {
                    var resp = await fetch(url, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        signal: controlador.signal,
                    });
                    var html = await resp.text();
                    if (controlador.signal.aborted) return;
                    resultado.innerHTML = html;
                    wireFilas(resultado);
                    history.replaceState(null, '', url);
                } catch (e) {
                    if (e.name !== 'AbortError') throw e;
                } finally {
                    if (peticionActual === controlador) peticionActual = null;
                }
            }

            input.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(function () { buscar(input.value.trim()); }, 350);
            });

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                clearTimeout(debounceTimer);
                buscar(input.value.trim());
            });
        })();
    </script>
}
