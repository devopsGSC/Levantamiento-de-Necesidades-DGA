@{
    ViewData["Title"] = "Recuperar Contraseña";
    Layout = "_AuthLayout";
}

<div class="auth-card__header">
    <h1 class="auth-card__title">Revisá tu correo</h1>
    <p class="auth-card__subtitle">Si el correo ingresado corresponde a una cuenta activa, vas a recibir un enlace para restablecer tu contraseña.</p>
</div>
<div class="auth-card__footer">
    <a asp-controller="Account" asp-action="Login">Volver al inicio de sesión</a>
</div>
