@model SolicitudDetailViewModel
@{
    ViewData["Title"] = $"Solicitud {Model.IdSolicitud}";
}

<div class="container-page" style="padding-top:28px;padding-bottom:40px;">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:20px;">
        <div>
            <h1 class="section-title" style="margin:0 0 6px;">Detalle de Solicitud #@Model.IdSolicitud</h1>
            <partial name="_EstadoBadge" model="@Model.Estado" />
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
            <a asp-action="Index" class="btn btn-outline btn-icon" title="Volver al listado" aria-label="Volver al listado"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg><span class="btn-action__tip">Volver al listado</span></a>
            <a asp-action="DescargarPdf" asp-route-id="@Model.Id" class="btn btn-outline is-pdf btn-icon" title="Descargar PDF" aria-label="Descargar PDF"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" /><path d="M14 2v6h6" /></svg><span class="btn-action__tip">PDF</span></a>
            <a asp-action="DescargarExcel" asp-route-id="@Model.Id" class="btn btn-outline is-excel btn-icon" title="Descargar Excel" aria-label="Descargar Excel"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" /><path d="M3 9h18" /><path d="M3 15h18" /><path d="M9 3v18" /></svg><span class="btn-action__tip">Excel</span></a>
            @if (Model.EsEditable)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-icon" title="Editar" aria-label="Editar"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" /><path d="m15 5 4 4" /></svg><span class="btn-action__tip">Editar</span></a>
            }
        </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;">
        <div class="card" style="padding:20px 22px;">
            <h3 style="margin:0 0 14px;font-size:15px;">Información General</h3>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;font-size:13.5px;">
                <div><div class="muted" style="color:var(--dga-muted);font-size:11.5px;text-transform:uppercase;">Responsable</div><div>@Model.NombreResponsable</div><div class="muted" style="color:var(--dga-muted);">@Model.Cargo</div></div>
                <div><div class="muted" style="color:var(--dga-muted);font-size:11.5px;text-transform:uppercase;">Aduana</div><div>@Model.Aduana</div><div class="muted" style="color:var(--dga-muted);">@Model.TipoAduana</div></div>
                <div><div class="muted" style="color:var(--dga-muted);font-size:11.5px;text-transform:uppercase;">Fecha de Registro</div><div>@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</div></div>
            </div>
        </div>
        <div class="card" style="padding:20px 22px;">
            <h3 style="margin:0 0 14px;font-size:15px;">Justificación</h3>
            <p style="font-size:13.5px;white-space:pre-wrap;margin:0 0 12px;">@Model.JustificacionGeneral</p>
            @if (!string.IsNullOrWhiteSpace(Model.ObservacionesGenerales))
            {
                <div class="muted" style="color:var(--dga-muted);font-size:11.5px;text-transform:uppercase;">Observaciones</div>
                <p style="font-size:13.5px;white-space:pre-wrap;margin:4px 0 0;">@Model.ObservacionesGenerales</p>
            }
        </div>
    </div>

    <div class="card" style="padding:20px 22px;margin-bottom:20px;">
        <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:10px;margin-bottom:16px;">
            <h3 style="margin:0;font-size:15px;">Ítems Solicitados (@Model.Items.Count)</h3>
            <span class="status-badge">Monto Presupuestado Total: <strong>@Model.MontoPresupuestadoTotal.ToString("$#,##0.00")</strong></span>
        </div>
        <div style="display:flex;flex-direction:column;gap:14px;">
            @foreach (var item in Model.Items)
            {
                <div class="card" style="padding:16px 18px;background:var(--dga-bg);">
                    <div style="display:flex;justify-content:space-between;margin-bottom:10px;">
                        <strong>Ítem #@item.NumeroItem</strong>
                        <span class="status-badge">@item.Prioridad</span>
                    </div>
                    <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:10px;font-size:13.5px;">
                        <div><div class="muted" style="color:var(--dga-muted);font-size:11px;text-transform:uppercase;">Componente</div>@item.Componente</div>
                        <div><div class="muted" style="color:var(--dga-muted);font-size:11px;text-transform:uppercase;">Subcomponente</div>@item.Subcomponente</div>
                        <div><div class="muted" style="color:var(--dga-muted);font-size:11px;text-transform:uppercase;">Elemento / Necesidad</div>@(item.Elemento ?? "-")</div>
                        @if (!string.IsNullOrWhiteSpace(item.Detalle))
                        {
                            <div><div class="muted" style="color:var(--dga-muted);font-size:11px;text-transform:uppercase;">Detalle</div>@item.Detalle</div>
                        }
                        <div><div class="muted" style="color:var(--dga-muted);font-size:11px;text-transform:uppercase;">Cantidad</div>@item.CantidadSolicitada</div>
                        @if (!string.IsNullOrWhiteSpace(item.TipoSuscripcion))
                        {
                            <div><div class="muted" style="color:var(--dga-muted);font-size:11px;text-transform:uppercase;">Suscripción</div>@item.TipoSuscripcion × @item.CantidadPeriodos @(item.TipoSuscripcion == "Anual" ? "año(s)" : "mes(es)")</div>
                        }
                        <div><div class="muted" style="color:var(--dga-muted);font-size:11px;text-transform:uppercase;">Costo Estimado (@(string.IsNullOrWhiteSpace(item.TipoSuscripcion) ? "unitario" : "por período"))</div>@item.CostoEstimado.ToString("$#,##0.00")</div>
                        <div><div class="muted" style="color:var(--dga-muted);font-size:11px;text-transform:uppercase;">Subtotal</div>@item.Subtotal.ToString("$#,##0.00")</div>
                        <div><div class="muted" style="color:var(--dga-muted);font-size:11px;text-transform:uppercase;">Ubicación Específica</div>@(item.UbicacionEspecifica ?? "-")</div>
                        @if (!string.IsNullOrWhiteSpace(item.JustificacionItem))
                        {
                            <div style="grid-column:1/-1;"><div class="muted" style="color:var(--dga-muted);font-size:11px;text-transform:uppercase;">Justificación del Ítem</div>@item.JustificacionItem</div>
                        }
                    </div>
                    @if (item.Fotografias.Count == 0)
                    {
                        <p class="muted" style="color:var(--dga-muted);font-size:12.5px;margin:10px 0 0;">Sin fotografías adjuntas</p>
                    }
                    else
                    {
                        <div class="photo-thumb-grid">
                            @foreach (var foto in item.Fotografias)
                            {
                                <button type="button" class="photo-thumb" data-foto-id="@foto.Id" data-foto-nombre="@foto.NombreOriginal">
                                    <img src="@Url.Action("Foto", "Solicitudes", new { solicitudItemFotografiaId = foto.Id })" alt="@foto.NombreOriginal" loading="lazy" />
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="card" style="padding:20px 22px;">
        <h3 style="margin:0 0 16px;font-size:15px;">Bitácora de Cambios</h3>
        @if (Model.Historial.Count == 0)
        {
            <p class="muted" style="color:var(--dga-muted);font-size:13px;">Sin movimientos registrados.</p>
        }
        else
        {
            <div style="display:flex;flex-direction:column;gap:10px;">
                @foreach (var h in Model.Historial)
                {
                    <div style="display:flex;gap:16px;font-size:13px;border-bottom:1px solid var(--dga-border);padding-bottom:10px;">
                        <div style="min-width:130px;color:var(--dga-muted);">@h.FechaCambio.ToString("dd/MM/yyyy HH:mm")</div>
                        <div>
                            <partial name="_EstadoBadge" model="@(h.EstadoAnterior ?? "—")" /> → <partial name="_EstadoBadge" model="@h.EstadoNuevo" />
                            @if (!string.IsNullOrWhiteSpace(h.Comentario))
                            {
                                <div class="muted" style="color:var(--dga-muted);margin-top:4px;">@h.Comentario</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.photo-thumb').forEach((btn) => {
            btn.addEventListener('click', () => {
                dgaLightbox('/Solicitudes/Foto?solicitudItemFotografiaId=' + btn.dataset.fotoId, btn.dataset.fotoNombre);
            });
        });
    </script>
}
